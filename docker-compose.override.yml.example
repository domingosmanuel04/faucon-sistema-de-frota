      - ./console/docker-patches/engines-dist/@fleetbase/iam-engine/assets/engine-6218e163b55529e90f9d536325c9bdfe.js:/usr/share/nginx/html/engines-dist/@fleetbase/iam-engine/assets/engine-6218e163b55529e90f9d536325c9bdfe.js:ro
