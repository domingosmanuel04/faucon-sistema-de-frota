# Exemplo versionado dos mounts Faucon.
# Uso local típico: copiar para docker-compose.override.yml (gitignored) e preencher secrets.
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
services:
  application:
    volumes:
      - ./api/docker-patches/AdminMetricsController.php:/fleetbase/api/vendor/fleetbase/core-api/src/Http/Controllers/Internal/v1/AdminMetricsController.php:ro
      - ./api/docker-patches/ControlTowerController.php:/fleetbase/api/vendor/fleetbase/core-api/src/Http/Controllers/Internal/v1/ControlTowerController.php:ro
      - ./api/docker-patches/FauconOpsController.php:/fleetbase/api/vendor/fleetbase/core-api/src/Http/Controllers/Internal/v1/FauconOpsController.php:ro
      - ./api/docker-patches/core-api-routes.php:/fleetbase/api/vendor/fleetbase/core-api/src/routes.php:ro
      - ./api/docker-patches/FauconOrderController.php:/fleetbase/api/vendor/fleetbase/fleetops-api/server/src/Http/Controllers/Internal/v1/FauconOrderController.php:ro
      - ./api/docker-patches/FauconApiOrderController.php:/fleetbase/api/vendor/fleetbase/fleetops-api/server/src/Http/Controllers/Api/v1/FauconApiOrderController.php:ro
      - ./api/docker-patches/fleetops-routes.php:/fleetbase/api/vendor/fleetbase/fleetops-api/server/src/routes.php:ro
      - ./api/docker-patches/FleetOpsSettingController.php:/fleetbase/api/vendor/fleetbase/fleetops-api/server/src/Http/Controllers/Internal/v1/SettingController.php:ro
      # Persist uploaded files under /storage without relying on an ephemeral container symlink
      - ./api/storage/app/public:/fleetbase/api/public/storage
      - ./docker/ensure-storage-link.sh:/usr/local/bin/ensure-storage-link.sh:ro
    entrypoint: ["/bin/sh", "/usr/local/bin/ensure-storage-link.sh"]
    command: ["docker-php-entrypoint", "sh", "-c", "php artisan octane:frankenphp --max-requests=1000 --port=8000 --host=0.0.0.0"]
    environment:
      APP_KEY: "${APP_KEY}"
      APP_NAME: "Faucon"
      APP_URL: "http://localhost:8000"
      CONSOLE_HOST: "http://localhost:4200"
      FRONTEND_HOSTS: "http://127.0.0.1:4200,http://localhost:4200"
      ENVIRONMENT: "development"
      APP_DEBUG: "true"
      FILESYSTEM_DRIVER: "public"
      DATABASE_URL: "${DATABASE_URL}"
      SESSION_DOMAIN: "localhost"
      MAIL_MAILER: "log"
      MAIL_FROM_ADDRESS: "hello@fleetbase.io"
      MAIL_FROM_NAME: "Faucon"
      GOOGLE_MAPS_LOCALE: "us"
      # Observabilidade (definir SENTRY_DSN no .env.local se tiver conta)
      SENTRY_LARAVEL_DSN: "${SENTRY_LARAVEL_DSN:-}"
      SENTRY_DSN: "${SENTRY_DSN:-}"
      SENTRY_TRACES_SAMPLE_RATE: "0.1"

  socket:
    environment:
      SOCKETCLUSTER_OPTIONS: '{"origins":"http://localhost:*,https://localhost:*,ws://localhost:*,wss://localhost:*"}'

  database:
    environment:
      MYSQL_ROOT_PASSWORD: "${MYSQL_ROOT_PASSWORD}"
      MYSQL_DATABASE: "fleetbase"
      MYSQL_USER: "fleetbase"
      MYSQL_PASSWORD: "${MYSQL_PASSWORD}"
      MYSQL_ALLOW_EMPTY_PASSWORD: "no"

  # Use published image instead of building locally (npm registry timeouts).
  # Production image has disableRuntimeConfig=true and empty API.host; mount a
  # patched bundle so the console talks to the local API/socket.
  console:
    image: fleetbase/fleetbase-console:latest
    build: !reset null
    ports: !override
      - "4200:4200"
    volumes:
      - ./console/fleetbase.config.json:/usr/share/nginx/html/fleetbase.config.json
      - ./console/docker-patches/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./console/docker-patches/index.html:/usr/share/nginx/html/index.html:ro
      - ./console/docker-patches/favicon:/usr/share/nginx/html/favicon:ro
      - ./console/docker-patches/favicon.ico:/usr/share/nginx/html/favicon.ico:ro
      - ./console/docker-patches/docs:/usr/share/nginx/html/docs:ro
      - ./console/docker-patches/torre:/usr/share/nginx/html/torre:ro
      - ./console/docker-patches/tracking:/usr/share/nginx/html/tracking:ro
      - ./console/docker-patches/features:/usr/share/nginx/html/features:ro
      - ./console/docker-patches/images/icon.png:/usr/share/nginx/html/images/icon.png:ro
      - ./console/docker-patches/images/icon-402c7816aa1fdbb54fa907d3a3e0ba18.png:/usr/share/nginx/html/images/icon-402c7816aa1fdbb54fa907d3a3e0ba18.png:ro
      - ./console/docker-patches/assets/vendor-06e3449278af5832aa3f5c4ebf12c1fe.js:/usr/share/nginx/html/assets/vendor-06e3449278af5832aa3f5c4ebf12c1fe.js:ro
      - ./console/docker-patches/assets/@fleetbase/console-2eb4b2507bff82bcbbbfb7fd639c3469.js:/usr/share/nginx/html/assets/@fleetbase/console-2eb4b2507bff82bcbbbfb7fd639c3469.js:ro
      - ./console/docker-patches/assets/pt-ui-runtime.js:/usr/share/nginx/html/assets/pt-ui-runtime.js:ro
      - ./console/docker-patches/engines-dist/@fleetbase/fleetops-engine/assets/engine-d256c1b0b8b46e3ebbd0c4cb0afdff8d.js:/usr/share/nginx/html/engines-dist/@fleetbase/fleetops-engine/assets/engine-d256c1b0b8b46e3ebbd0c4cb0afdff8d.js:ro
      - ./console/docker-patches/engines-dist/@fleetbase/fleetops-engine/assets/engine-vendor-71cb7692ee2365b8a0fd387a128e2bd9.js:/usr/share/nginx/html/engines-dist/@fleetbase/fleetops-engine/assets/engine-vendor-71cb7692ee2365b8a0fd387a128e2bd9.js:ro
