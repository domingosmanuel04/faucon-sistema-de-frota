{{page-title "Visão geral"}}

<div class="mx-auto flex w-full max-w-7xl flex-col gap-4 p-4 md:p-6">
    <div class="grid w-full gap-4 lg:grid-cols-2">
        <section class="rounded-md border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
            <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Perfil da organização</h2>
            <dl class="mt-3 divide-y divide-gray-100 text-sm dark:divide-gray-700">
                <div class="flex justify-between gap-4 py-2">
                    <dt class="text-gray-500 dark:text-gray-400">Nome</dt>
                    <dd class="break-words text-right font-medium text-gray-900 dark:text-white">{{this.organization.name}}</dd>
                </div>
                <div class="flex justify-between gap-4 py-2">
                    <dt class="text-gray-500 dark:text-gray-400">Telefone</dt>
                    <dd class="text-right text-gray-900 dark:text-white">{{n-a this.organization.phone}}</dd>
                </div>
                <div class="flex justify-between gap-4 py-2">
                    <dt class="text-gray-500 dark:text-gray-400">Website</dt>
                    <dd class="break-all text-right text-gray-900 dark:text-white">{{n-a this.organization.website_url}}</dd>
                </div>
                <div class="flex justify-between gap-4 py-2">
                    <dt class="text-gray-500 dark:text-gray-400">País</dt>
                    <dd class="text-right text-gray-900 dark:text-white">{{n-a this.organization.country}}</dd>
                </div>
                <div class="flex justify-between gap-4 py-2">
                    <dt class="text-gray-500 dark:text-gray-400">Fuso horário</dt>
                    <dd class="text-right text-gray-900 dark:text-white">{{n-a this.organization.timezone}}</dd>
                </div>
                <div class="flex justify-between gap-4 py-2">
                    <dt class="text-gray-500 dark:text-gray-400">Moeda</dt>
                    <dd class="text-right text-gray-900 dark:text-white">{{n-a this.organization.currency}}</dd>
                </div>
                <div class="flex justify-between gap-4 py-2">
                    <dt class="text-gray-500 dark:text-gray-400">IP do proprietário</dt>
                    <dd class="font-mono text-right text-gray-900 dark:text-white">{{n-a this.owner.ip_address}}</dd>
                </div>
                <div class="flex justify-between gap-4 py-2">
                    <dt class="text-gray-500 dark:text-gray-400">Registado em</dt>
                    <dd class="text-right text-gray-900 dark:text-white">{{n-a this.organization.createdAt}}</dd>
                </div>
                <div class="flex justify-between gap-4 py-2">
                    <dt class="text-gray-500 dark:text-gray-400">Última atualização</dt>
                    <dd class="text-right text-gray-900 dark:text-white">{{n-a this.organization.updatedAt}}</dd>
                </div>
            </dl>

            <div class="mt-4 border-t border-gray-200 pt-4 dark:border-gray-700">
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Proprietário</h3>
                {{#if this.owner}}
                    <div class="mt-3 flex items-start gap-3">
                        <Image src={{this.owner.avatar_url}} class="h-9 w-9 flex-shrink-0 rounded-full border border-gray-200 object-cover dark:border-gray-700" />
                        <div class="min-w-0">
                            <div class="break-words text-sm font-medium text-gray-900 dark:text-white">{{n-a this.ownerName}}</div>
                            <div class="break-all text-sm text-gray-500 dark:text-gray-400">{{n-a this.ownerEmail}}</div>
                            <div class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{n-a this.ownerPhone}}</div>
                        </div>
                    </div>
                {{else}}
                    <p class="mt-3 text-sm text-amber-700 dark:text-amber-300">Nenhum proprietário está atribuído a esta organização.</p>
                {{/if}}
            </div>
        </section>

        <section class="rounded-md border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
            <div class="flex items-center justify-between gap-3">
                <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Operações e utilização</h2>
                {{#if @model.usageError}}
                    <Button @icon="refresh" @text="Tentar novamente" @size="xs" @onClick={{this.refresh}} />
                {{/if}}
            </div>
            {{#if @model.usageError}}
                <p class="mt-2 text-xs text-amber-700 dark:text-amber-300" role="status">Não foi possível carregar a utilização. Tente novamente para obter os totais mais recentes.</p>
            {{/if}}
            <dl class="mt-3 divide-y divide-gray-100 text-sm dark:divide-gray-700" data-test-organization-usage>
                {{#each this.usageRows as |row|}}
                    <div class="flex items-center justify-between gap-4 py-2" data-test-usage-row={{row.key}}>
                        <dt class="text-gray-500 dark:text-gray-400">{{row.label}}</dt>
                        <dd class="text-right font-medium tabular-nums text-gray-900 dark:text-white">
                            {{#if (eq row.value null)}}
                                <span class="font-normal text-gray-500 dark:text-gray-400">Indisponível</span>
                            {{else}}
                                {{format-number row.value}}
                            {{/if}}
                        </dd>
                    </div>
                {{/each}}
            </dl>
            <p class="mt-3 text-xs leading-5 text-gray-500 dark:text-gray-400">Os totais referem-se a esta organização. As chamadas à API e os callbacks de webhook refletem registos retidos, não o tráfego total. Um total fica indisponível quando a respetiva fonte de dados não está instalada ou não pôde ser carregada.</p>

            <div class="mt-4 border-t border-gray-200 pt-4 dark:border-gray-700">
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Acesso e integração</h3>
                <dl class="mt-3 space-y-3 text-sm">
                    <div class="flex items-center justify-between gap-4">
                        <dt class="text-gray-500 dark:text-gray-400">Estado</dt>
                        <dd><Badge @status={{if (eq this.organization.status "active") "success" "warning"}} @hideStatusDot={{true}}>{{this.statusLabel}}</Badge></dd>
                    </div>
                    <div class="flex items-center justify-between gap-4">
                        <dt class="text-gray-500 dark:text-gray-400">Integração</dt>
                        <dd><Badge @status={{if this.organization.onboarding_completed "success" "warning"}} @hideStatusDot={{true}}>{{this.onboardingState}}</Badge></dd>
                    </div>
                </dl>
            </div>
        </section>

        <RegistryYield @registry="console:admin:organization:overview-panels" @context={{hash organization=this.organization}} as |RegistryComponent context|>
            <RegistryComponent @organization={{context.organization}} />
        </RegistryYield>

        <section class="rounded-md border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800 lg:col-span-2">
            <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Atividade recente</h2>
            <ActivityLog @companyUuid={{this.organization.uuid}} @maxVisibleActivities={{5}} @showHeader={{false}} @showControls={{false}} class="mt-3" />
        </section>
    </div>
    <Spacer @height="100px" />
</div>
