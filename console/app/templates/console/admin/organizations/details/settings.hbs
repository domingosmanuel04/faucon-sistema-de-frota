{{page-title "Definições"}}

<div class="mx-auto grid w-full max-w-7xl gap-3 p-4 md:grid-cols-2 md:p-6">
    <section class="rounded-md border bg-white p-3 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h2 class="text-xs font-bold uppercase text-gray-900 dark:text-white">Definições da Organização</h2>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Perfil principal da organização, telefone e moeda.</p>
            </div>
            <Button @icon="edit" @text="Editar" @size="xs" @type="primary" @onClick={{this.editOrganization}} />
        </div>

        <div class="mt-3 space-y-2 text-sm">
            <div class="flex justify-between gap-4">
                <span class="text-gray-500 dark:text-gray-400">Nome</span>
                <span class="text-right font-medium text-gray-900 dark:text-white">{{@model.name}}</span>
            </div>
            <div class="flex justify-between gap-4">
                <span class="text-gray-500 dark:text-gray-400">Descrição</span>
                <span class="text-right font-medium text-gray-900 dark:text-white">{{n-a @model.description}}</span>
            </div>
            <div class="flex justify-between gap-4">
                <span class="text-gray-500 dark:text-gray-400">Telefone</span>
                <span class="text-right font-medium text-gray-900 dark:text-white">{{n-a @model.phone}}</span>
            </div>
            <div class="flex justify-between gap-4">
                <span class="text-gray-500 dark:text-gray-400">Moeda</span>
                <span class="text-right font-medium text-gray-900 dark:text-white">{{n-a @model.currency}}</span>
            </div>
            <div class="flex justify-between gap-4">
                <span class="text-gray-500 dark:text-gray-400">Fuso horário</span>
                <span class="text-right font-medium text-gray-900 dark:text-white">{{n-a @model.timezone}}</span>
            </div>
        </div>
    </section>

    <RegistryYield @registry="console:admin:organization:settings-panels" @context={{hash organization=@model}} as |RegistryComponent context|>
        <RegistryComponent @organization={{context.organization}} />
    </RegistryYield>

    <section class="rounded-md border bg-white p-3 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <h2 class="text-xs font-bold uppercase text-gray-900 dark:text-white">Controlos de Ciclo de Vida</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Alterações de estado e onboarding ficam registadas na atividade da organização.</p>

        <div class="mt-4 space-y-3">
            <div class="flex items-center justify-between gap-4 rounded-md border border-gray-100 p-3 dark:border-gray-700">
                <div>
                    <div class="text-sm font-semibold text-gray-900 dark:text-white">Estado da Organização</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Suspender, reativar ou marcar acesso como inativo.</div>
                </div>
                <div class="flex flex-wrap justify-end gap-2">
                    <Button @size="xs" @text="Ativar" @icon="circle-check" @onClick={{fn this.setStatus "active"}} />
                    <Button @size="xs" @text="Inativo" @icon="circle-pause" @onClick={{fn this.setStatus "inactive"}} />
                    <Button @size="xs" @type="danger" @text="Suspender" @icon="ban" @onClick={{fn this.setStatus "suspended"}} />
                </div>
            </div>

            <div class="flex items-center justify-between gap-4 rounded-md border border-gray-100 p-3 dark:border-gray-700">
                <div>
                    <div class="text-sm font-semibold text-gray-900 dark:text-white">Estado do Onboarding</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Corrigir manualmente o estado de onboarding para suporte.</div>
                </div>
                <div class="flex flex-wrap justify-end gap-2">
                    <Button @size="xs" @text="Marcar como concluído" @icon="circle-check" @onClick={{fn this.setOnboarding true}} />
                    <Button @size="xs" @text="Marcar como incompleto" @icon="triangle-exclamation" @onClick={{fn this.setOnboarding false}} />
                </div>
            </div>
        </div>
    </section>

    <section class="rounded-md border bg-white p-3 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <h2 class="text-xs font-bold uppercase text-gray-900 dark:text-white">Zona de Perigo</h2>
        <div class="mt-4 rounded-md border border-dashed border-gray-200 p-4 text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400">
            A eliminação da organização e a limpeza de dados permanecem indisponíveis até existirem fluxos de confirmação e contratos de purge separados.
        </div>
    </section>
</div>
